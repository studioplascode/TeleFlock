{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TeleFlock",
        "width": 1440,
        "height": 900,
        "minWidth": 420,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 14, "y": 20 },
        "transparent": false,
        "backgroundColor": "#0b0b10"
      }
    ]
  },
  "bundle": {
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    }
  }
}
